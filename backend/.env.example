# Server
PORT=3002

# MongoDB Atlas - use real URI. No <cluster> or placeholders. URL-encode password if it has special chars.
# Example: mongodb+srv://USER:PASSWORD@HOST.mongodb.net/shamal?appName=shamal
DB_URL=

# JWT - keep secret in production
JWT_SECRET=

# CORS - allowed origins (frontend = public site, admin = admin panel)
# Frontend: 3000, Admin: 3001
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Seed admin (for npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: public URL for API. Default: http://localhost:PORT
# API_PUBLIC_URL=https://api.example.com
