# Server Configuration
PORT=3002
NODE_ENV=production

# MongoDB Connection
# Use MongoDB Atlas connection string
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Alternative: MONGO_URI (both supported)

# JWT Secret (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origins (no trailing slashes)
# Frontend URL (Vercel)
CLIENT_URL=https://your-frontend.vercel.app

# Admin Panel URL (Vercel)
ADMIN_URL=https://your-admin.vercel.app

# Admin Seed (optional - for initial admin creation)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure-password-123
